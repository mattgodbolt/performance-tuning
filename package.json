{
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fmt": "prettier --write . && clang-format -i *.cpp *.c",
    "fmt:check": "prettier --check . && clang-format --dry-run --Werror *.cpp *.c",
    "prepare": "husky"
  },
  "dependencies": {
    "reveal-ce": "^1.3.0",
    "vite": "^8.0.10"
  },
  "lint-staged": {
    "*.{cpp,c,h,hpp,cc,cxx}": "clang-format -i",
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "clang-format": "^1.8.0",
    "husky": "^9.1.7",
    "less": "^4.6.4",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.3",
    "vite-plugin-static-copy": "^4.1.0"
  }
}
